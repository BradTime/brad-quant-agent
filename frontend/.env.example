# 前端运行时配置（Next.js 公共变量，构建时内联）。本地用 .env.local 覆盖。
# M20: 浏览器走同源相对路径 /api/v1（Next rewrite 到 FastAPI），HttpOnly Cookie 落在前端域。
# rewrite 目标由服务端 BACKEND_URL 控制（默认 http://127.0.0.1:8000），勿写进 NEXT_PUBLIC_*。
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws/v1
# BACKEND_URL=http://127.0.0.1:8000
