# Copy to deploy/production.env, chmod 600, and never commit that file.
APP_DOMAIN=quant.example.com

# Keep POSTGRES_PASSWORD and the URL-encoded password in DATABASE_URL identical.
POSTGRES_USER=quant_agent
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=quant_agent
DATABASE_URL=postgresql+psycopg2://quant_agent:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/quant_agent

REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/0
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=quant-agent
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_QUOTE_TTL_SECONDS=604800
REDIS_QUOTE_L1_TTL_SECONDS=1
REDIS_SCHEDULER_LEASE_SECONDS=30
REDIS_SCHEDULER_RENEW_SECONDS=10
WORKER_HEARTBEAT_TTL_SECONDS=30
READINESS_STARTUP_GRACE_SECONDS=60

APP_ENV=production
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
WS_TICKET_EXPIRE_SECONDS=120
AUTH_OUTBOX_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_FERNET_GENERATE_KEY
AUTH_AUTO_VERIFY_REGISTRATION=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=Quant Agent <noreply@example.com>
SMTP_STARTTLS=true

DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional integrations.
TUSHARE_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LANGCHAIN_API_KEY=
LLMQUANT_ENABLED=false
LLMQUANT_API_KEY=

# Compose owns PROCESS_ROLE separately for API and worker.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
