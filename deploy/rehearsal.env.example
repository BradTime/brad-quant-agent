# NON-PRODUCTION ONLY. Deterministic credentials make local rehearsal repeatable.
COMPOSE_PROJECT_NAME=brad-quant-agent-rehearsal
PRODUCTION_ENV_FILE=./deploy/rehearsal.env.example
APP_DOMAIN=localhost
HTTP_PORT=18080
HTTPS_PORT=18443

POSTGRES_USER=quant_agent
POSTGRES_PASSWORD=rehearsal-postgres-only
POSTGRES_DB=quant_agent
DATABASE_URL=postgresql+psycopg2://quant_agent:rehearsal-postgres-only@postgres:5432/quant_agent

REDIS_PASSWORD=rehearsal-redis-only
REDIS_URL=redis://:rehearsal-redis-only@redis:6379/0
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=quant-agent-rehearsal

APP_ENV=production
JWT_SECRET=9f2a7c4e1d8b3a605e4c9f1b7d2a8e3c6f0b4d9a1e7c5b2f8a3d6e0c4b9f1a7d
WS_TICKET_EXPIRE_SECONDS=120
AUTH_OUTBOX_ENCRYPTION_KEY=SrXQqUMFuuKrQdsSLBBNlD9Mobv0p7J_inHM95xeTvM=
AUTH_AUTO_VERIFY_REGISTRATION=false

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=rehearsal
SMTP_PASSWORD=rehearsal
SMTP_FROM=noreply@localhost
SMTP_STARTTLS=true

DEEPSEEK_API_KEY=
RAG_ENABLED=false
EMBEDDING_WARM_ON_START=false
ENABLE_REALTIME_FETCH=false
ENABLE_SCHEDULER=true
QUOTE_REFRESH_SECONDS=3600
INDEX_REFRESH_SECONDS=3600
